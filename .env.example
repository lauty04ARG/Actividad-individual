# ==============================================================================
# Variables de Entorno de Desarrollo - ComunidadCursos
# Copiar este archivo a .env antes de levantar con docker compose:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de Datos (PostgreSQL 18.6)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=comunidad_cursos
POSTGRES_PORT=5432

# Cadena de conexión interna para Docker Compose
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/comunidad_cursos

# Cadena de conexión alternativa si se corre el backend local sin Docker
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/comunidad_cursos

# ------------------------------------------------------------------------------
# Backend (FastAPI + uv)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Seguridad y Autenticación (JWT)
JWT_SECRET_KEY=dev_secret_key_super_segura_para_firmar_tokens_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Frontend (React 19 + Vite + pnpm)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
